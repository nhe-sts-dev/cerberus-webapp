// Prisma schema for Better Auth
// learn more: https://better-auth.com/docs/concepts/database

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
  // Add binaryTargets to support Vercel's serverless environment
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// NOTE: When using mysql or sqlserver, uncomment the //@db.Text annotations in model Account below
// Further reading:
// https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@index([name])
}

model User {
  id            String    @id
  name          String //@db.Text
  email         String
  emailVerified Boolean   @default(false)
  image         String? //@db.Text
  busImages BusImage[]
  // password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]
  posts         Post[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String? //@db.Text
  userAgent String? //@db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String //@db.Text
  providerId            String //@db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String? //@db.Text
  refreshToken          String? //@db.Text
  idToken               String? //@db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String? //@db.Text
  password              String? //@db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String //@db.Text
  value      String //@db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}


enum LabelStatus {
  DIRTY
  CLEAN
  UNCERTAIN
  UNLABELED
}

enum Weather {
  SUNNY
  RAINY
  OVERCAST
  NIGHT
}

enum Angle {
  FRONT
  SIDE
  REAR
}

// --- Enums for ML ---
enum ModelArchitecture {
  MOBILENET_V2
  MOBILENET_V3
  RESNET_18
  YOLO_V8
}

enum ModelStatus {
  EXPERIMENTAL
  STAGING
  PRODUCTION
  DEPRECATED
}



model BusImage {
  id               String       @id @default(cuid())
  imageUrl         String
  label            LabelStatus? @default(UNLABELED)
  confidence       Int?         // 1-100 scale representing "level of dirty", because the positive case is dirty
  
  // Fleet & Hardware Context
  fleetNumber      String?      // e.g., "Bus-402"
  cameraId         String?      // e.g., "Axis-P1465-SouthGate"
  
  // Environmental Context
  timeTaken        DateTime?
  weatherCondition Weather?     
  cameraAngle      Angle?       
  
  // Workflow Data
  isVerified       Boolean      @default(false)
  labeledById      String?      
  labeledBy        User?        @relation(fields: [labeledById], references: [id])

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // A bus image can be part of many training datasets
  trainingData     DatasetImage[]
  inferences       InferenceLog[] // Links to the model's predictions
  transponderLogs  TransponderLog[]
}

model TransponderLog {
  id          String   @id @default(cuid())
  fleetNumber String
  gateId      String?  // e.g., "Depot-South-Gate"
  timestamp   DateTime // Exact time the bus passed the transponder
  
  // Link to the image once the matching algorithm pairs them
  matchedImageId String? @unique
  matchedImage   BusImage? @relation(fields: [matchedImageId], references: [id])

  createdAt   DateTime @default(now())
}

model InferenceLog {
  id          String        @id @default(cuid())
  
  // THE MODEL'S PREDICTION
  predictedLabel LabelStatus 
  confidence     Int           // 1-100 scale
  
  // RELATIONS
  imageId     String
  image       BusImage      @relation(fields: [imageId], references: [id], onDelete: Cascade)
  
  modelId     String
  model       ModelRegistry @relation(fields: [modelId], references: [id])
  
  createdAt   DateTime      @default(now())
}


// --- MLOps Models ---

// Represents a specific training dataset (e.g., "Dataset-Q1-2026")
model Dataset {
  id          String         @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime       @default(now())
  
  images      DatasetImage[]
  models      ModelRegistry[]
}

// Join table for many-to-many relationship between Dataset and BusImage
model DatasetImage {
  datasetId   String
  imageId     String
  
  dataset     Dataset  @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  image       BusImage @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([datasetId, imageId])
}

// The core registry for your trained models
model ModelRegistry {
  id              String            @id @default(cuid())
  name            String            // e.g., "bus-classifier-v1"
  version         String?           // e.g., "v1.0.0"
  architecture    ModelArchitecture
  status          ModelStatus       @default(EXPERIMENTAL)
  
  // Storage
  weightsUrl      String?            // S3/R2 URI to the .tflite file
  eapUrl          String?  // The compiled .eap URL
  
  // ML Metadata (JSON allows flexible schema for hyperparameters and metrics)
  hyperparameters Json?             // e.g., { "learning_rate": 0.001, "batch_size": 32, "epochs": 50 }
  metrics         Json?             // e.g., { "accuracy": 0.92, "f1_score": 0.89, "val_loss": 0.15 }
  
  // Which dataset was used to train this?
  datasetId       String?
  dataset         Dataset?          @relation(fields: [datasetId], references: [id])

  // inference logs
  inferences       InferenceLog[]

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([name, version])
}